<Ui xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!--
        Contributing, listed only by the Blizzard-client .toc files. On the 1.12, 2.4.3 and 3.3.5
        clients contributing is off for now, and the 1.12 client's Lua 5.0 cannot even parse
        these files (they use the length operator). Left out of
        addon.xml so those clients never load them: no Contribute table, so no button.
    -->
    <Include file="UI\ContributeBox.lua"/>
    <Include file="Contribute.lua"/>
    <Include file="Gather.lua"/>
    <!-- The dialogue core's, for the quest and gossip windows (Dialogue/Dialogue.xml). -->
    <Include file="Dialogue\Contribute.lua"/>
    <Include file="Dialogue\ContributeButton.lua"/>
</Ui>
