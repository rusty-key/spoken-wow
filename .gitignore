# Shared
.DS_Store
.env
.env*.local
.vscode/settings.json
node_modules/
RELEASE

# Packaged addon zips and the data modules built into them. Both projects'
# Makefiles write here from the repo root; `make quests-package` and
# `make zones-package` do not yet partition it.
/dist/
generated


# --- quests -------------------------------------------------------------------

__pycache__
/pipelines/quests/.venv/
datagrip

# Planning artifacts from the superpowers skills. Specs and plans written to drive a
# piece of work, kept locally and never committed: what they describe is either in the
# code by now or was abandoned, and a reader cannot tell which from the document.
superpowers/

# vmangos dumps, needed only to refresh the corpus
/pipelines/quests/sql-data
/pipelines/quests/assets/sql/db_dump
/pipelines/quests/assets/sql/mysql-dump

# The folder a quests pack is built from, assembled from the take archive by
# `make quests-sounds` and thrown away by the next one. Nothing in it is kept anywhere else
# only if it predates the archive; see scripts/audio/sounds.mjs.
# Anchored: an unanchored "audio/" also swallowed web/src/app/api/audio/.
/pipelines/quests/audio/

# Clips uploaded to build voice clones. Like the audio store: not committable, but losing
# them means a voice can never be remade, so back them up.
/pipelines/quests/voice/samples/

# The fish.audio reference cut from each slot's clips, per language. Cut again from the
# samples if lost, but a take records the clip's hash, so a re-cut is a different reference.
/pipelines/quests/voice/references/

# NPC voice lines kept locally while working on voices. Audio never goes in git.
/pipelines/quests/voice/npc-lines/

# Every take of every line, pulled from the droplet: the only quests audio there is. Some of
# it predates this project's ability to reproduce it - back it up too.
/pipelines/quests/audio-history/

# Rendered pronunciation previews. Unlike the two above this one is safe to lose: every file
# is rebuildable by spending credits again, and nothing refers to one.
/pipelines/quests/audio-previews/

# Transcoded copies of the store, keyed on the md5 of the master each came from. A cache and
# nothing more: every entry is one ffmpeg run away from existing again, which is exactly what
# audio-history/ is not.
/pipelines/quests/audio-transcoded/

# Local clips that voices are seeded from. Not part of what this project ships.
/pipelines/quests/voice/seed-clips/

/pipelines/quests/tools/.lines_cache.pkl

# The hiccup scan's output. One command rebuilds it from a corpus that is committed, and it
# exists to be filled in while reviewing - a committed copy would conflict with every
# reviewer's own.
/docs/quests/docs/corpus-hiccups.csv

# Design notes for work not committed to. Local thinking, not project documentation.
/docs/quests/specs/


# --- zones --------------------------------------------------------------------

# Raw MediaWiki API responses. Regenerate with `node pipelines/zones/tools/scrape.mjs`.
/pipelines/zones/tools/cache/

# The client's map tables from wago.tools, for `make books-places`.
/pipelines/books/tools/cache/

# The pack's clips, assembled from the take archive by `make zones-sounds`.
# No trailing slash: a test client is pointed at this pack by symlinking its audio in,
# and a trailing slash matches only a real directory, leaving the link to be committed.
/addons/SpokenZonesAudio/Sounds
# Another language's pack, staged by `make <section>-sounds LOCALE=xx` and the lookups and
# manifests built beside it. Build output, never committed: the pages under publishers/ are
# what says a language has a pack.
/build/

# The books narration, in the pack folder the client loads. Same rule and same reason as
# the zones pack above, including the missing trailing slash: a test client is pointed at
# this pack by symlinking it, and a trailing slash matches only a real directory, leaving
# the link to be committed. Filled by `make books-pull-history && make books-sounds`.
/addons/SpokenBooksAudio/Sounds

# Every books take, pulled from the droplet.
/pipelines/books/audio-history/

# Transcoded sound-pack clips, keyed by the checksum of the master they came from.
# A build cache: scripts/zones/package-audio.sh refills it, and prunes entries whose
# master has been re-cut. Outside dist/ so `make clean` does not cost a five-minute
# re-encode. Roughly half the size of Sounds/ per tier.
/pipelines/zones/audio-transcoded/

# Every zones take, pulled from the droplet: the only zones audio there is. Grows without
# bound -- re-cutting the whole corpus adds ~700MB.
/pipelines/zones/audio-history/

# --- apps ---------------------------------------------------------------------

/apps/*/.next/
/apps/*/next-env.d.ts
/apps/*/tsconfig.tsbuildinfo

# The release directory the deploy workflows assemble. Built by CI; reproducible
# locally by following the "Assemble release" step in the workflow.
/release/
