# Copy to spoken-release.env beside the script and fill it in. Keep it to yourself: it holds tokens.

# The folder the Spoken Manager installs into, for the game whose packs you release.
ADDONS_DIR="/path/to/World of Warcraft/_classic_era_/Interface/AddOns"

# The language you release. --lang overrides it.
SPOKEN_LANG=ptBR

# CurseForge: a token from https://authors-old.curseforge.com/account/api-tokens, and your project
# id for each pack, as CF_<folder>. A pack with no id is skipped on CurseForge.
CF_TOKEN=
CF_SpokenQuestsAudioAlliance_ptBR=
CF_SpokenQuestsAudioHorde_ptBR=
CF_SpokenQuestsAudioShared_ptBR=
CF_SpokenQuestsAudioGossip_ptBR=
CF_SpokenPlacesAudio_ptBR=
CF_SpokenReadablesAudio_ptBR=
CF_SpokenBossesAudio_ptBR=

# GitHub: a token that may write Contents on the repository, and the repository, which needs at
# least one commit for a release to tag.
GH_TOKEN=
GH_REPO=owner/repo

# Only when a client patch outdates the script's own list: CurseForge's game version names, spaced.
# CF_GAME_VERSIONS="1.15.9 2.5.6 1.60.1"
