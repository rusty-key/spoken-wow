# Copy to .env (gitignored) and fill in what you need. Nothing here is required to build an
# addon from a clone: the corpora and the manifests are committed, and every target that
# needs a credential says so.
#
# THE SHARED HALF, AND ONLY THAT. A variable belongs here when more than one pipeline, or a
# pipeline and the site, reads it. What is one project's alone stays in that project's file:
# apps/web/.env.example lists the site's accounts and secrets, and a pipeline may add its
# own pipelines/<name>/.env, which is read after this one and wins.
#
# Read by pipelines/lib/env.mjs (zones, books), tts_cli/env_vars.py (quests),
# apps/web/next.config.ts and apps/web/vitest.config.ts (the site), and the three
# scripts/*/release.sh. Production reads none of it -- the droplet has shared/app.env
# instead; see deploy/web/README.md.

# CurseForge author token for the release scripts, from
# https://authors-old.curseforge.com/account/api-tokens
#
# Tied to the account rather than to a project, so one token uploads all six.
# Only needed on the machine that publishes releases.
CURSEFORGE_TOKEN=

# Wago author token, the same arrangement for the Wago addon pages.
WAGO_TOKEN=

# ElevenLabs, for the quests and books pipelines' own generation. The site does NOT use
# this: every request there is spent from the signed-in editor's own key, which /profile
# stores encrypted. See apps/web/.env.example's SPOKEN_SECRET_KEY.
ELEVENLABS_API_KEY=

# Claude credentials for pipelines/places/tools/rewrite-lore.mjs, which rewrites wiki
# articles into lore. Only that one command needs it -- scraping, the addon builds and the
# voice pipelines all run without it. Responses are cached under tools/cache/rewrite/, so a
# re-run of an unchanged zone with an unchanged prompt costs nothing.
ANTHROPIC_API_KEY=

# The site's database: the lore corpus, the book corpus and the voiceline takes. One
# cluster for all three sections since the merge, on the default port. Local only; prod is
# pushed deliberately with `make db-push`.
#
# Unset, pipelines/places/tools/voice/* fall back to reading tools/voice/manifest.json
# directly, which is all the addon build needs, so a clone with no Postgres can still
# package the addon. --dictionary-drift is the one selector that requires it: the
# dictionary a take would be compared against lives in the pronunciation_lexicon row, not
# in a file.
DATABASE_URL=postgres://localhost/spoken_quests_dev

# The vmangos world database, which the quests and books extracts both read. One dump on
# the machine, loaded once; a second copy is hundreds of megabytes and another thing to
# keep in step with a refresh. These values match pipelines/quests/docker-compose.yml.
#
# Both readers let this file win over the shell for these five, and neither did so by
# accident: generic names like MYSQL_PASSWORD are exported by other projects, and an
# ambient one turns "connect to the local vmangos" into an access-denied error that reads
# like a missing dump.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=wow
MYSQL_DATABASE=mangos

# Cloudflare R2 S3 API token for both buckets, the manager channel and the audio archive.
# Only needed on a machine that writes to either.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The manager channel's bucket, served as spoken-packs.rusty.one.
R2_BUCKET=
# Signs the channel's index and manifests (ed25519, made by scripts/manager/keygen.mjs).
SPOKEN_PACKS_SIGNING_KEY=

# Public audio archive, every clip named by its SHA-256. With SPOKEN_ARCHIVE_URL set,
# `make <section>-pull-live` reads clips from it instead of the droplet.
# SPOKEN_ARCHIVE_STORE: disk (default, needs no keys), dual or r2.
SPOKEN_ARCHIVE_URL=
SPOKEN_ARCHIVE_BUCKET=
SPOKEN_ARCHIVE_STORE=disk
